# Copy this file to secrets.toml (same folder) and fill in your real key.
# Get a free Gemini API key from https://aistudio.google.com/apikey
#
# Local run:   copy to .streamlit/secrets.toml
# Streamlit Community Cloud: paste the same content into
#   App settings -> Secrets (do NOT commit your real key to GitHub)

GEMINI_API_KEY = "paste-your-key-here"
